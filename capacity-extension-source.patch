+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {KNOWLEDGE_ENTRY_LIMIT,validateKnowledge,knowledgeIndex,knowledgePaths,entryPath,renderKnowledgeMarkdown} from '../lib/knowledge-library.js';
+import {validatePublicSnapshot} from '../lib/public-research-reader.js';
+import {searchDocuments,rankResearch} from '../lib/research-search.js';
+import {validateContentUpdate} from '../scripts/validate-content-intake.mjs';
+import {createCloudflareWorker} from '../cloudflare/worker.js';
+
+const seed=JSON.parse(fs.readFileSync(new URL('../../../outputs/public-research-data.json',import.meta.url),'utf8'));
+function fixture(count){
+ const data=structuredClone(seed);
+ while(data.knowledge.entries.length<count){
+  const n=data.knowledge.entries.length;
+  data.knowledge.entries.push({id:'capacity-fixture-'+n,title:'Capacity fixture '+n,name:'Capacity fixture '+n,kind:'topic',category:data.knowledge.categories[0].id,summary:'In-memory capacity fixture',research_date:'2026-10-20',status:'Test only',source_labels:['Test fixture'],keywords:['capacity-fixture-'+n],sections:[{heading:'Fixture body',paragraphs:['Capacity fixture paragraph '+n]}],related:[]});
+ }
+ return data;
+}
+
+test('5006 entries retain every full-text document, stable URL and machine-index row',()=>{
+ const data=fixture(5006),last=data.knowledge.entries.at(-1),origin='https://example.com';
+ validatePublicSnapshot(data);
+ const docs=searchDocuments(data.knowledge,{snapshot:data});
+ assert.equal(knowledgeIndex(data.knowledge,origin,data.checked_at).entries.length,5006);
+ const indexed=new Map(docs.map(d=>[d.path,d.id]));
+ for(const entry of data.knowledge.entries)assert.equal(indexed.get(entryPath(entry)),entry.id);
+ assert(knowledgePaths(data.knowledge).includes(entryPath(last)));
+ assert(renderKnowledgeMarkdown(data.knowledge,new URL(origin+entryPath(last)+'index.md'),origin).includes(last.sections[0].paragraphs[0]));
+ assert(rankResearch(docs,last.title).some(r=>r.doc.id===last.id));
+});
+
+test('the finite shared entry ceiling still rejects one entry beyond its boundary',()=>{
+ const data=fixture(KNOWLEDGE_ENTRY_LIMIT);
+ assert.equal(validateKnowledge(data.knowledge).entries.length,KNOWLEDGE_ENTRY_LIMIT);
+ data.knowledge.entries.push({...data.knowledge.entries.at(-1),id:'capacity-fixture-over-limit'});
+ assert.throws(()=>validateKnowledge(data.knowledge),/Invalid knowledge library/);
+});
+
+test('the deployment status reports the same finite entry ceiling enforced by the reader',async()=>{
+ const worker=createCloudflareWorker({seed,origin:'https://example.com',revision:'a'.repeat(64),builtAt:'2026-10-20T00:00:00Z'},{fetcher:async()=>{throw Error('Offline test');}});
+ const response=await worker.fetch(new Request('https://example.com/publication-status.json'));
+ assert.equal(response.status,200);
+ assert.equal((await response.json()).knowledge_entry_limit,KNOWLEDGE_ENTRY_LIMIT);
+});
+
+test('entry extension does not relax the independent snapshot character limit',()=>{
+ const data=structuredClone(seed);
+ for(let i=0;JSON.stringify(data).length<=8388608;i++)data.knowledge.entries[i].sections[0].paragraphs.push('x'.repeat(9000));
+ assert.throws(()=>validateContentUpdate(seed,data),/exceeds current reader capacity/);
+});
