+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {redirectLegacyRequest} from '../legacy-entry-redirects/sites-worker.js';
+const formal='https://zhongshuderen.pages.dev';
+test('legacy request redirects immediately with path and query preserved and no HTML body',async()=>{
+ for(const path of ['/','/library/method-evidence/','/library/?q=%E9%87%8F%E5%8C%96&type=methods&page=2']){
+  const r=redirectLegacyRequest(new Request('https://zhongshu-research.fast-pearl-5182.chatgpt.site'+path));
+  assert.equal(r.status,308);assert.equal(r.headers.get('location'),formal+path);assert.equal(await r.text(),'');
+ }
+});
+test('a double-slash path cannot select a different destination origin',()=>{
+ const r=redirectLegacyRequest(new Request('https://zhongshu-research.fast-pearl-5182.chatgpt.site//untrusted.example/path?q=1'));
+ assert.equal(new URL(r.headers.get('location')).origin,formal);assert.equal(new URL(r.headers.get('location')).pathname,'//untrusted.example/path');
+});
+test('legacy Netlify only publishes a tiny redirect package and removes old edge routes',()=>{
+ const config=fs.readFileSync(new URL('../netlify.toml',import.meta.url),'utf8');
+ assert(config.includes('legacy-entry-redirect.zip legacy-netlify'));assert(config.includes('publish = "legacy-netlify"'));
+ assert(config.includes('from = "/*"'));assert(config.includes('to = "https://zhongshuderen.pages.dev/:splat"'));assert(config.includes('status = 301'));assert(config.includes('force = true'));
+ assert(!config.includes('[[edge_functions]]'));assert(!config.includes('website-source.zip'));
+ assert.equal(fs.readFileSync(new URL('../legacy-entry-redirects/_redirects',import.meta.url),'utf8').trim(),'/* https://zhongshuderen.pages.dev/:splat 301!');
+ const html=fs.readFileSync(new URL('../legacy-entry-redirects/index.html',import.meta.url),'utf8');assert(!html.includes('<script'));assert(!html.includes('refresh'));assert(html.includes('<body></body>'));
+});
