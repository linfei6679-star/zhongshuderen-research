+// Prepared legacy Sites handler. Not deployed without authorized source push.
+// No page, banner, countdown or new site.
+export function redirectLegacyRequest(request){
+ const incoming=new URL(request.url),target=new URL('https://zhongshuderen.pages.dev');
+ target.pathname=incoming.pathname;
+ target.search=incoming.search;
